#!/bin/bash
# Elmoorx v4 — مُشغّل مستقل (لا يحتاج npm/npx)
# =============================================
# الاستخدام: ./elmoorx dev
#           ./elmoorx build --target=browser
#           ./elmoorx visual
#
# هذا البرنامج النصي يكتشف Node.js ويُشغّل CLI مباشرة.

set -e

# اكتشاف مسار هذا السكربت
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# اكتشاف Node.js
NODE="${NODE:-node}"

if ! command -v $NODE &> /dev/null; then
  echo "✗ خطأ: Node.js غير مُثبّت"
  echo "  ثبّته من: https://nodejs.org/ (الإصدار 22 أو أحدث)"
  exit 1
fi

# تحقق من الإصدار
NODE_VERSION=$($NODE --version | sed 's/v//' | cut -d. -f1)
if [ "$NODE_VERSION" -lt 22 ]; then
  echo "⚠ تحذير: يُفضّل Node.js 22+ (لديك $NODE_VERSION)"
fi

# شغّل CLI
exec $NODE --experimental-strip-types "$SCRIPT_DIR/elmoorx.mjs" "$@"
